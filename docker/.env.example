# Proyecto
PROJECT_NAME=studio
BACKEND_PORT=8000
NGINX_PORT=8000

# Volúmenes (rutas relativas a esta carpeta)
DB_VOLUME=../data_local
APP_VOLUME=../studio
STATIC_VOLUME=../studio/static
MEDIA_VOLUME=../studio/media

# Django
DEBUG=true
SECRET_KEY=cambiar-por-una-clave-segura
ALLOWED_HOSTS=*
FRONTEND_URL=http://localhost:3000
CANCEL_HOURS_LIMIT=2

# Base de datos
POSTGRES_ENGINE=django.db.backends.postgresql
POSTGRES_DB=studio
POSTGRES_DATABASE=studio
POSTGRES_USER=studio
POSTGRES_PASSWORD=studio
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Notificaciones por WhatsApp (opcional)
API_WPP_SEND_MESSAGE=
API_WPP_SEND_PDF=
API_WPP_SEND_WAITLIST=
API_WPP_SEND_BIRTHDAY=
API_WPP_VERIFY=

# Emails con Brevo (opcional)
BREVO_API_KEY=
BREVO_SENDER_NAME=STUDIO
BREVO_SENDER_EMAIL=

# Comando de arranque del contenedor
BACKEND_COMMAND=python manage.py migrate && python manage.py runserver 0.0.0.0:8000

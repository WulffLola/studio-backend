# Proyecto
PROJECT_NAME=studio
BACKEND_PORT=8000
NGINX_PORT=8000

# Volúmenes (rutas relativas a esta carpeta)
DB_VOLUME=../data_local
APP_VOLUME=../studio
STATIC_VOLUME=../studio/static
MEDIA_VOLUME=../studio/media

# Django
DEBUG=true
SECRET_KEY=cambiar-por-una-clave-segura
ALLOWED_HOSTS=*
FRONTEND_URL=http://localhost:3000
CANCEL_HOURS_LIMIT=2

# Seguridad de sesiones y login (ver docs / apps/users/sessions.py y lockout.py)
# Proxies de confianza delante de Django para obtener la IP real (nginx del compose = 1)
AUTH_PROXY_COUNT=1
# true = solo cuentan como actividad las peticiones con el header X-Client-Idle
AUTH_ACTIVITY_HEADER_REQUIRED=false
# Comprobantes de pago privados: ruta FUERA de MEDIA_ROOT (requiere un volumen
# persistente propio). Vacío = comportamiento anterior (media/payments).
PRIVATE_MEDIA_ROOT=

# Base de datos
POSTGRES_ENGINE=django.db.backends.postgresql
POSTGRES_DB=studio
POSTGRES_DATABASE=studio
POSTGRES_USER=studio
POSTGRES_PASSWORD=studio
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Notificaciones por WhatsApp (opcional)
API_WPP_SEND_MESSAGE=
API_WPP_SEND_PDF=
API_WPP_SEND_WAITLIST=
API_WPP_SEND_BIRTHDAY=
API_WPP_VERIFY=

# Emails con Brevo (opcional)
BREVO_API_KEY=
BREVO_SENDER_NAME=STUDIO
BREVO_SENDER_EMAIL=

# Comando de arranque del contenedor
BACKEND_COMMAND="python manage.py migrate && python manage.py collectstatic --noinput && python manage.py runserver 0.0.0.0:8000"
